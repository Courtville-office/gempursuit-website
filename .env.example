# Supabase (server-side only) — source of truth for subscribers
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — used purely as an email transport
RESEND_API_KEY=
RESEND_FROM_ADDRESS="Gem Pursuit <info@gempursuit.com>"

# Where contact form messages get emailed
CONTACT_INBOX=info@gempursuit.com

# Public site origin used in email links and redirects
SITE_URL=https://gempursuit.com

# Random secret used by the new-episode cron route
CRON_SECRET=

# Behold.so feed IDs for the home page Instagram + TikTok widgets
# Sign up at https://behold.so, connect your accounts, copy each feed ID
NEXT_PUBLIC_BEHOLD_INSTAGRAM_FEED_ID=
NEXT_PUBLIC_BEHOLD_TIKTOK_FEED_ID=

# Sanity CMS — content is fetched from here at build / revalidate time
NEXT_PUBLIC_SANITY_PROJECT_ID=tfw6v3tl
NEXT_PUBLIC_SANITY_DATASET=production
# Optional read token for fetching draft content. Leave blank for prod.
SANITY_API_READ_TOKEN=
